{
  "manifest_version": 3,
  "name": "Meteora QP — Quick Position",
  "version": "0.1.0",
  "description": "Быстрое открытие DLMM-позиции на Meteora: сумма в SOL и диапазон в процентах в один клик.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://app.meteora.ag/*"],
      "js": [
        "src/settings.js",
        "src/dom.js",
        "src/actions.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
